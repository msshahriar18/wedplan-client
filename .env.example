# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB (same database as the server)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=wedplandb

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used to sign tokens for the Express API, must match the server
JWT_SECRET=

# Express API
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ImgBB (used on the server side only, never exposed to the browser)
IMGBB_API_KEY=
